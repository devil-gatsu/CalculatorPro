{
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
	 "action": {
		"default_popup": "dragonbound.html"
     },
    "web_accessible_resources": [{
        "resources": ["assets/css.css", "assets/pack.js", "assets/Observe.js", "assets/script.js", "assets/DragonBound.js"],
        "matches": ["<all_urls>"]
    }],
    "name": "Dragonbound.net Aimbot - Superbot (MagicMath)",
    "description": "Aimbot 2026 - Updated for Personal Server Testing",
    "manifest_version": 3,
    "version": "1.0.132",
    "icons": {
        "16": "assets/icons/16.png",
        "19": "assets/icons/19.png",
        "24": "assets/icons/24.png",
        "32": "assets/icons/32.png",
        "48": "assets/icons/48.png",
        "64": "assets/icons/64.png",
        "128": "assets/icons/128.png",
        "256": "assets/icons/256.png",
        "512": "assets/icons/512.png"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self' 'unsafe-eval'; object-src 'self'"
    },
    "permissions": ["*://*/*", "tabs", "management", "scripting"],
    "host_permissions": ["<all_urls>"]
}